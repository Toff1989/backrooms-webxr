# Copier en `.env` (jamais committé, voir .gitignore) et remplir avant `docker compose up`
# ou avant de lancer le serveur directement (`server/.env`, ou variables d'environnement).

# Secret HMAC pour signer les tokens de run (server/src/token.ts). Générer avec :
#   openssl rand -hex 32
RUN_TOKEN_SECRET=

# Journal de debug du client (?debug=1) : jeton pour le relire via
#   GET /api/debug-log?token=...   (vide = relecture désactivée ; l'écriture reste possible).
# Générer avec : openssl rand -hex 16
DEBUG_LOG_TOKEN=
