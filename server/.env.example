# Copier en `server/.env` (jamais committé, voir .gitignore). Chargé automatiquement au démarrage
# (server/src/env.ts) — utile pour l'hébergement Node.js natif Plesk (Phusion Passenger, voir
# docs/DEPLOIEMENT-PLESK.md), où il n'y a pas d'autre moyen de passer des variables d'environnement
# sans passer par l'interface Plesk. `scripts/plesk-install.sh` génère ce fichier automatiquement.

NODE_ENV=production

# Secret HMAC pour signer les tokens de run (server/src/token.ts). Générer avec :
#   openssl rand -hex 32
RUN_TOKEN_SECRET=

# Fait confiance à l'en-tête X-Forwarded-For du proxy Plesk/nginx pour connaître la vraie IP du
# visiteur (nécessaire pour que la limitation de débit ne s'applique pas à tout le monde à la fois).
# Mettre à 0 pour désactiver (dev sans proxy devant). Voir server/src/server.ts.
TRUST_PROXY=1
